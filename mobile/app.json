{
  "expo": {
    "name": "LifeLink",
    "slug": "lifelink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "lifelink",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.lifelink.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LifeLink uses the camera to scan QR codes and upload documents.",
        "NSLocationWhenInUseUsageDescription": "LifeLink uses your location to find nearby hospitals and donors."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E53935"
      },
      "package": "org.lifelink.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "lifelink-mobile-app"
      }
    }
  }
}
